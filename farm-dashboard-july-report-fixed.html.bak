      {field_id: "field_013", area_acres: 3.07, soil_series: "Ely", surface_texture: "Silt loam", hydrologic_group: "B", drainage_class: "Well drained", om_pct: 1.74, ph: 6.05, carbon_stock: 18.7, soil_health_score: 0.761, soil_health_category: "Medium", k_factor: 0.336, bulk_density: 1.35, mean_ndvi: 0.57153100, min_ndvi: 0.387585, max_ndvi: 0.617099, yield_bu_acre: 54.29, predicted_bushels: 166.82, avg_temp: 26.14, precipitation_mm: 167.44, humidity_pct: 74.27, solar_radiation: 685.03, temp_f: 79.1, ndvi_date: "2025-07-17", yield_source: "CDL 2024 rotation + July 2025 NDVI Regression", ndvi_source: "July 2025 Sentinel-2", crop: "Soybeans"},
      {field_id: "field_014", area_acres: 11.16, soil_series: "Ely", surface_texture: "Silt loam", hydrologic_group: "B", drainage_class: "Well drained", om_pct: 1.72, ph: 6.29, carbon_stock: 67.2, soil_health_score: 0.799, soil_health_category: "Medium", k_factor: 0.336, bulk_density: 1.35, mean_ndvi: 0.43574600, min_ndvi: 0.349174, max_ndvi: 0.621578, yield_bu_acre: 46.14, predicted_bushels: 514.78, avg_temp: 26.14, precipitation_mm: 167.44, humidity_pct: 74.27, solar_radiation: 685.03, temp_f: 79.1, ndvi_date: "2025-07-17", yield_source: "CDL 2024 rotation + July 2025 NDVI Regression", ndvi_source: "July 2025 Sentinel-2", crop: "Soybeans"},
      {field_id: "field_015", area_acres: 22.31, soil_series: "Ely", surface_texture: "Silt loam", hydrologic_group: "B", drainage_class: "Well drained", om_pct: 1.72, ph: 6.29, carbon_stock: 134.3, soil_health_score: 0.799, soil_health_category: "Medium", k_factor: 0.336, bulk_density: 1.35, mean_ndvi: 0.69166000, min_ndvi: 0.493972, max_ndvi: 0.717218, yield_bu_acre: 154.50, predicted_bushels: 3446.65, avg_temp: 26.14, precipitation_mm: 167.44, humidity_pct: 74.27, solar_radiation: 685.03, temp_f: 79.1, ndvi_date: "2025-07-17", yield_source: "CDL 2024 rotation + July 2025 NDVI Regression", ndvi_source: "July 2025 Sentinel-2", crop: "Corn"},
      {field_id: "field_016", area_acres: 7.38, soil_series: "Ely", surface_texture: "Silt loam", hydrologic_group: "B", drainage_class: "Well drained", om_pct: 1.72, ph: 6.29, carbon_stock: 44.4, soil_health_score: 0.799, soil_health_category: "Medium", k_factor: 0.336, bulk_density: 1.35, mean_ndvi: 0.66099800, min_ndvi: 0.512, max_ndvi: 0.72, yield_bu_acre: 148.98, predicted_bushels: 1099.33, avg_temp: 26.14, precipitation_mm: 167.44, humidity_pct: 74.27, solar_radiation: 685.03, temp_f: 79.1, ndvi_date: "2025-07-17", yield_source: "CDL 2024 rotation + July 2025 NDVI Regression", ndvi_source: "July 2025 Sentinel-2", crop: "Corn"},
      {field_id: "field_017", area_acres: 9.47, soil_series: "Ely", surface_texture: "Silt loam", hydrologic_group: "B", drainage_class: "Well drained", om_pct: 1.72, ph: 6.29, carbon_stock: 57.0, soil_health_score: 0.799, soil_health_category: "Medium", k_factor: 0.336, bulk_density: 1.35, mean_ndvi: 0.68290300, min_ndvi: 0.52, max_ndvi: 0.73, yield_bu_acre: 60.97, predicted_bushels: 577.24, avg_temp: 26.14, precipitation_mm: 167.44, humidity_pct: 74.27, solar_radiation: 685.03, temp_f: 79.1, ndvi_date: "2025-07-17", yield_source: "CDL 2024 rotation + July 2025 NDVI Regression", ndvi_source: "July 2025 Sentinel-2", crop: "Soybeans"},
      {field_id: "field_018", area_acres: 31.41, soil_series: "Ely", surface_texture: "Silt loam", hydrologic_group: "B", drainage_class: "Well drained", om_pct: 1.72, ph: 6.29, carbon_stock: 189.1, soil_health_score: 0.799, soil_health_category: "Medium", k_factor: 0.336, bulk_density: 1.35, mean_ndvi: 0.63934300, min_ndvi: 0.45, max_ndvi: 0.71, yield_bu_acre: 145.08, predicted_bushels: 4556.95, avg_temp: 26.14, precipitation_mm: 167.44, humidity_pct: 74.27, solar_radiation: 685.03, temp_f: 79.1, ndvi_date: "2025-07-17", yield_source: "CDL 2024 rotation + July 2025 NDVI Regression", ndvi_source: "July 2025 Sentinel-2", crop: "Corn"},
      {field_id: "field_019", area_acres: 8.34, soil_series: "Ely", surface_texture: "Silt loam", hydrologic_group: "B", drainage_class: "Well drained", om_pct: 1.70, ph: 6.35, carbon_stock: 49.6, soil_health_score: 0.797, soil_health_category: "Medium", k_factor: 0.336, bulk_density: 1.35, mean_ndvi: 0.61895600, min_ndvi: 0.48, max_ndvi: 0.7, yield_bu_acre: 57.14, predicted_bushels: 476.43, avg_temp: 26.14, precipitation_mm: 167.44, humidity_pct: 74.27, solar_radiation: 685.03, temp_f: 79.1, ndvi_date: "2025-07-17", yield_source: "CDL 2024 rotation + July 2025 NDVI Regression", ndvi_source: "July 2025 Sentinel-2", crop: "Grass/Pasture"},
      {field_id: "field_020", area_acres: 6.10, soil_series: "Ely", surface_texture: "Silt loam", hydrologic_group: "B", drainage_class: "Well drained", om_pct: 1.55, ph: 6.38, carbon_stock: 33.1, soil_health_score: 0.784, soil_health_category: "Medium", k_factor: 0.336, bulk_density: 1.35, mean_ndvi: 0.40179500, min_ndvi: 0.3, max_ndvi: 0.55, yield_bu_acre: 44.11, predicted_bushels: 269.15, avg_temp: 26.14, precipitation_mm: 167.44, humidity_pct: 74.27, solar_radiation: 685.03, temp_f: 79.1, ndvi_date: "2025-07-17", yield_source: "CDL 2024 rotation + July 2025 NDVI Regression", ndvi_source: "July 2025 Sentinel-2", crop: "Soybeans"}
    ];

    const fieldFilter = document.getElementById('field-filter');
    const soilFilter = document.getElementById('soil-filter');
    const healthFilter = document.getElementById('health-filter');
    const tbody = document.getElementById('field-tbody');
    const modalOverlay = document.getElementById('modal-overlay');
    const modalClose = document.getElementById('modal-close');
    const modalTitle = document.getElementById('modal-title');
    const modalBody = document.getElementById('modal-body');

    const soilTypes = [...new Set(FARM_DATA.map(f => f.surface_texture))].sort();

    soilTypes.forEach(soil => {
      const opt = document.createElement('option');
      opt.value = soil;
      opt.textContent = soil;
      soilFilter.appendChild(opt);
    });

    let currentSort = { field: 'field_id', asc: true };
    let selectedFieldId = null;

    function formatNumber(num) {
      return Math.round(num).toLocaleString();
    }

    function getYieldClass(yield_val) {
      if (yield_val >= 100) return 'yield-good';
      if (yield_val >= 70) return 'yield-med';
      return 'yield-low';
    }

    function getTextureBadge(texture) {
      const lower = texture.toLowerCase();
      let cls = 'silt-loam';
      if (lower.includes('clay')) cls = 'clay';
      else if (lower.includes('sand')) cls = 'sand';
      return `<span class="soil-badge ${cls}">${texture}</span>`;
    }

    function getHealthBadge(category) {
      const cat = category ? category.toLowerCase() : 'medium';
      return `<span class="health-badge ${cat}">${category || 'Medium'}</span>`;
    }

    function getNdviAlert(ndvi, crop) {
      if (ndvi < 0.40) {
        if (crop === 'Corn') return { level: 'warning', msg: 'Field needs immediate attention. Scout for nitrogen deficiency, pest damage, or diseases such as northern corn leaf blight.' };
        if (crop === 'Soybeans') return { level: 'warning', msg: 'Field needs immediate attention. Scout for iron chlorosis, nodulation failure, or diseases like brown stem rot.' };
        return { level: 'warning', msg: 'Field needs immediate attention. Recommend urgent scouting for pest pressure or disease.' };
      }
      if (ndvi < 0.50) {
        if (crop === 'Corn') return { level: 'warning', msg: 'Field needs attention. Scout for nitrogen deficiency, pest pressure, or early disease signs such as northern corn leaf blight.' };
        if (crop === 'Soybeans') return { level: 'warning', msg: 'Field needs attention. Scout for aphid pressure, soybean cyst nematode, or foliar diseases.' };
        return { level: 'warning', msg: 'Field needs attention. Recommend immediate scouting for pest pressure or disease.' };
      }
      if (ndvi < 0.60) return { level: 'info', msg: 'Index within normal range. Continue current management.' };
      return { level: 'info', msg: 'Healthy vegetation index. Active growth confirmed.' };
    }

    function renderNdviAlert(fields) {
      const alertBox = document.getElementById('ndvi-alert');
      if (!fields.length) { alertBox.innerHTML = ''; return; }
      
      const lowNdviFields = fields.filter(f => f.mean_ndvi < 0.5);
      const avgNdvi = fields.reduce((s, f) => s + f.mean_ndvi, 0) / fields.length;
      
      if (lowNdviFields.length > 0) {
        alertBox.className = 'ndvi-alert warning';
        const fieldList = lowNdviFields.map(f => {
          const advisory = getNdviAlert(f.mean_ndvi, f.crop);
          return `• <strong>${f.field_id}</strong> (${f.crop}, NDVI: ${f.mean_ndvi.toFixed(3)}): ${advisory.msg}`;
        }).join('<br>');
        alertBox.innerHTML = `<strong>⚠ ${lowNdviFields.length} Field${lowNdviFields.length > 1 ? 's' : ''} Need Attention:</strong><br>${fieldList}`;
      } else {
        const cropCount = {};
        fields.forEach(f => { cropCount[f.crop] = (cropCount[f.crop] || 0) + 1; });
        const dominantCrop = Object.entries(cropCount).sort((a, b) => b[1] - a[1])[0]?.[0] || 'Any';
        const alert = getNdviAlert(avgNdvi, dominantCrop);
        alertBox.className = 'ndvi-alert ' + alert.level;
        alertBox.innerHTML = alert.level === 'warning' ? '<strong>⚠ Crop Advisory:</strong> ' + alert.msg : '<strong>✓ Status:</strong> ' + alert.msg;
      }
    }

    function renderTable(fields) {
      tbody.innerHTML = '';
      if (fields.length === 0) {
        tbody.innerHTML = '<tr><td colspan="10" class="no-results">No fields match your filters</td></tr>';
        return;
      }

      fields.sort((a, b) => {
        const aVal = a[currentSort.field];
        const bVal = b[currentSort.field];
        if (typeof aVal === 'string') {
          return currentSort.asc ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
        }
        return currentSort.asc ? aVal - bVal : bVal - aVal;
      });

      fields.forEach(field => {
        const ndviPct = Math.min(field.mean_ndvi * 100 * 2, 100);
        const yieldClass = getYieldClass(field.yield_bu_acre);
        const isLowNdvi = field.mean_ndvi < 0.5;
        const row = document.createElement('tr');
        row.dataset.fieldId = field.field_id;
        if (selectedFieldId === field.field_id) row.classList.add('selected');
        if (isLowNdvi) row.classList.add('ndvi-warning');
        
        const ndviDisplay = isLowNdvi ? `⚠ ${field.mean_ndvi.toFixed(3)}` : field.mean_ndvi.toFixed(3);
        
        row.innerHTML = `
          <td><strong>${field.field_id}</strong></td>
          <td>${formatNumber(field.area_acres)}</td>
          <td>${field.soil_series}</td>
          <td>${getTextureBadge(field.surface_texture)}</td>
          <td>${getHealthBadge(field.soil_health_category)}</td>
          <td>
            <div style="display: flex; align-items: center;">
              <div class="ndvi-bar"><div class="ndvi-fill" style="width: ${ndviPct}%"></div></div>
              <span>${ndviDisplay}</span>
            </div>
          </td>
          <td>${field.om_pct.toFixed(2)}%</td>
          <td>${field.ph.toFixed(2)}</td>
          <td class="${yieldClass}">${field.yield_bu_acre.toFixed(1)} bu/acre</td>
          <td>${formatNumber(field.predicted_bushels)} bu</td>
        `;
        row.addEventListener('click', () => showModal(field));
        tbody.appendChild(row);
      });
    }

    function updateKPIs(fields) {
      const totalAcres = fields.reduce((sum, f) => sum + f.area_acres, 0);
      const avgNdvi = fields.length > 0 ? fields.reduce((sum, f) => sum + f.mean_ndvi, 0) / fields.length : 0;
      const totalBushels = fields.reduce((sum, f) => sum + f.predicted_bushels, 0);
      const avgHealth = fields.length > 0 ? fields.reduce((sum, f) => sum + f.soil_health_score, 0) / fields.length : 0;
      const avgPh = fields.length > 0 ? fields.reduce((sum, f) => sum + f.ph, 0) / fields.length : 0;
      const avgOm = fields.length > 0 ? fields.reduce((sum, f) => sum + f.om_pct, 0) / fields.length : 0;

      document.getElementById('kpi-ndvi').textContent = avgNdvi.toFixed(3);
      document.getElementById('kpi-ndvi-hint').textContent = `${fields.length} field${fields.length !== 1 ? 's' : ''} in view`;
      document.getElementById('kpi-acres').textContent = formatNumber(totalAcres);
      document.getElementById('kpi-bushels').textContent = formatNumber(totalBushels);
      document.getElementById('kpi-health').textContent = avgHealth.toFixed(2);
      document.getElementById('kpi-ph').textContent = avgPh.toFixed(2);
      document.getElementById('kpi-om').textContent = avgOm.toFixed(2) + '%';
    }

    function formatDate(dateStr) {
      const d = new Date(dateStr);
      return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    function showModal(field) {
      selectedFieldId = field.field_id;
      modalTitle.textContent = `${field.field_id} - ${field.soil_series}`;
      
      const omBar = (field.om_pct / 4) * 100;
      const healthBar = field.soil_health_score * 100;
      
      // Get NDVI date
      const ndviDate = field.ndvi_date ? formatDate(field.ndvi_date) : 'N/A';
      
      // Get NDVI map for this field with error handling
      let ndviMapData = null;
      let hasNdviMap = false;
      try {
        if (typeof NDVI_MAPS !== 'undefined' && NDVI_MAPS) {
          ndviMapData = NDVI_MAPS[field.field_id];
          hasNdviMap = ndviMapData && ndviMapData.length > 100;
        }
      } catch (e) {
        console.error('Error loading NDVI map for', field.field_id, e);
        hasNdviMap = false;
      }
      
      const ndviMapSection = hasNdviMap ? `
        <div class="modal-section">
          <h3>NDVI Satellite Map</h3>
          <img class="viz-image modal-ndvi-map" src="data:image/png;base64,${ndviMapData}" alt="NDVI Map for ${field.field_id}" onerror="this.onerror=null;this.src='';this.parentElement.innerHTML='<p>Image failed to load</p>';">
          <p style="font-size: 0.7rem; color: #666; margin-top: 6px; text-align: center;">Click to enlarge</p>
        </div>
      ` : '<div class="modal-section"><h3>NDVI Satellite Map</h3><p>No map available</p></div>';
      
      modalBody.innerHTML = ndviMapSection;

        ${(function(){
          const advisory = getNdviAlert(field.mean_ndvi, field.crop);
          const healthClass = advisory.level === 'warning' ? 'ndvi-alert warning' : 'ndvi-alert info';
          const statusIcon = advisory.level === 'warning' ? '⚠' : '✓';
          const yieldStatus = field.yield_bu_acre >= 140 ? 'Strong' : field.yield_bu_acre >= 100 ? 'Average' : 'Below Average';
          return `<div class="modal-section">
            <h3>Field Synopsis</h3>
            <div class="${healthClass}" style="margin-bottom: 12px;">
              <strong>${statusIcon} ${field.field_id} - ${field.crop}</strong><br>
              ${advisory.msg}
            </div>
            <div class="modal-grid">
              <div class="modal-item"><span>Current Status</span><span>${advisory.level === 'warning' ? 'Needs Attention' : 'Healthy'}</span></div>
              <div class="modal-item"><span>Yield Outlook</span><span>${yieldStatus}</span></div>
              <div class="modal-item"><span>Predicted Yield</span><span>${field.yield_bu_acre.toFixed(1)} bu/acre</span></div>
              <div class="modal-item"><span>Soil Health</span><span>${field.soil_health_category}</span></div>
            </div>
          </div>`;
        })()}
        
        <div class="modal-section">
          <h3>Basic Information</h3>
          <div class="modal-grid">
            <div class="modal-item"><span>Field ID</span><span>${field.field_id}</span></div>
            <div class="modal-item"><span>Total Acres</span><span>${formatNumber(field.area_acres)} ac</span></div>
            <div class="modal-item"><span>Soil Series</span><span>${field.soil_series}</span></div>
            <div class="modal-item"><span>Surface Texture</span><span>${field.surface_texture}</span></div>
            <div class="modal-item"><span>Hydrologic Group</span><span>${field.hydrologic_group}</span></div>
            <div class="modal-item"><span>Drainage Class</span><span>${field.drainage_class}</span></div>
          </div>
        </div>
        
        <div class="modal-section">
          <h3>Soil Metrics</h3>
          <div class="modal-grid">
            <div class="modal-item"><span>Organic Matter</span><span>${field.om_pct.toFixed(2)}%</span></div>
            <div class="modal-item"><span>pH</span><span>${field.ph.toFixed(2)}</span></div>
            <div class="modal-item"><span>Carbon Stock</span><span>${field.carbon_stock.toFixed(1)} units</span></div>
            <div class="modal-item"><span>K-Factor (erosion)</span><span>${field.k_factor.toFixed(3)}</span></div>
            <div class="modal-item"><span>Bulk Density</span><span>${field.bulk_density.toFixed(2)} g/cm³</span></div>
            <div class="modal-item"><span>Soil Health Score</span><span>${field.soil_health_score.toFixed(3)} / 1.00</span></div>
          </div>
          <div style="margin-top: 10px;">
            <div style="font-size: 0.75rem; color: #666; margin-bottom: 3px;">Organic Matter: ${field.om_pct.toFixed(2)}%</div>
            <div class="chart-bar"><div class="chart-bar-fill" style="width: ${omBar}%"></div></div>
            <div style="font-size: 0.75rem; color: #666; margin-bottom: 3px; margin-top: 6px;">Soil Health: ${field.soil_health_score.toFixed(2)} / 1.00</div>
            <div class="chart-bar"><div class="chart-bar-fill" style="width: ${healthBar}%"></div></div>
          </div>
        </div>
        
        <div class="modal-section">
          <h3>NDVI & Yield</h3>
          <div class="modal-grid">
            <div class="modal-item"><span>Mean NDVI</span><span>${field.mean_ndvi.toFixed(3)} (index)</span></div>
            <div class="modal-item"><span>Min NDVI</span><span>${field.min_ndvi.toFixed(3)}</span></div>
            <div class="modal-item"><span>Max NDVI</span><span>${field.max_ndvi.toFixed(3)}</span></div>
            <div class="modal-item"><span>NDVI Date</span><span>${ndviDate}</span></div>
            <div class="modal-item"><span>Yield</span><span>${field.yield_bu_acre.toFixed(1)} bu/acre</span></div>
            <div class="modal-item"><span>Predicted Bushels</span><span>${formatNumber(field.predicted_bushels)} bu</span></div>
            <div class="modal-item"><span>Health Category</span>${getHealthBadge(field.soil_health_category)}</div>
          </div>
          ${(function(){const a=getNdviAlert(field.mean_ndvi,field.crop);return'<div class="ndvi-alert '+a.level+'" style="margin-top:12px;"><strong>'+(a.level==='warning'?'⚠ Crop Advisory:':'✓ Status:')+'</strong> '+a.msg+'</div>'})()}
        </div>
        
        <div class="modal-section">
          <h3>Weather (July 2025)</h3>
          <div class="modal-grid">
            <div class="modal-item"><span>Avg Temperature</span><span>${field.temp_f}°F</span></div>
            <div class="modal-item"><span>Total Precipitation</span><span>${field.precipitation_mm.toFixed(0)} mm</span></div>
            <div class="modal-item"><span>Avg Humidity</span><span>${field.humidity_pct.toFixed(1)}%</span></div>
            <div class="modal-item"><span>Solar Radiation</span><span>${field.solar_radiation.toFixed(0)} MJ/m²</span></div>
          </div>
        </div>
      `;
      
      modalOverlay.classList.add('active');
      renderTable(getFilteredFields());
    }

    function closeModal() {
      modalOverlay.classList.remove('active');
      selectedFieldId = null;
      renderTable(getFilteredFields());
    }

    function getFilteredFields() {
      const selectedField = fieldFilter.value;
      const selectedSoil = soilFilter.value;
      const selectedHealth = healthFilter.value;

      let filtered = FARM_DATA;
      if (selectedField) filtered = filtered.filter(f => f.field_id === selectedField);
      if (selectedSoil) filtered = filtered.filter(f => f.surface_texture === selectedSoil);
      if (selectedHealth) filtered = filtered.filter(f => f.soil_health_category === selectedHealth);
      return filtered;
    }

    function filterFields() {
      const filtered = getFilteredFields();
      renderTable(filtered);
      updateKPIs(filtered);
      renderNdviAlert(filtered);
    }

    document.querySelectorAll('.field-table th').forEach(th => {
      th.addEventListener('click', () => {
        const field = th.dataset.sort;
        if (currentSort.field === field) {
          currentSort.asc = !currentSort.asc;
        } else {
          currentSort.field = field;
          currentSort.asc = true;
        }
        filterFields();
      });
    });

    fieldFilter.addEventListener('change', filterFields);
    soilFilter.addEventListener('change', filterFields);
    healthFilter.addEventListener('change', filterFields);
    modalClose.addEventListener('click', closeModal);
    modalOverlay.addEventListener('click', (e) => {
      if (e.target === modalOverlay) closeModal();
    });
    
    // Viz modal handling for clicking on NDVI maps to enlarge
    const vizModal = document.getElementById('viz-modal');
    const vizModalImg = document.getElementById('viz-modal-img');
    const vizModalClose = document.getElementById('viz-modal-close');
    
    if (vizModal && vizModalImg && vizModalClose) {
      vizModalClose.addEventListener('click', () => {
        vizModal.classList.remove('active');
        vizModalImg.src = '';
      });
      vizModal.addEventListener('click', (e) => {
        if (e.target === vizModal) {
          vizModal.classList.remove('active');
          vizModalImg.src = '';
        }
      });
    }
    
    // Add click handler for modal NDVI map to enlarge
    document.addEventListener('click', (e) => {
      if (e.target && e.target.classList.contains('modal-ndvi-map') && vizModal && vizModalImg) {
        vizModalImg.src = e.target.src;
        vizModal.classList.add('active');
      }
    });

    renderTable(FARM_DATA);
    updateKPIs(FARM_DATA);
    renderNdviAlert(FARM_DATA);

    console.log('Dashboard initialized, FARM_DATA length:', FARM_DATA.length);
    console.log('tbody element:', tbody);
    console.log('tbody innerHTML:', tbody ? tbody.innerHTML.substring(0, 200) : 'NO TBODY');
    } catch(e) {
      console.error('Dashboard init error:', e);
      console.error(e.stack);
      document.body.innerHTML = '<h1 style="color:red;padding:20px;">Error loading dashboard: ' + e.message + '</h1>';
    }

    </script>
